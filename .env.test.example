# National Material Intelligence & Harmonization Platform
# Example Environment Variables (Testing)

# Database Settings
# Note: Always use a dedicated test database to avoid dropping dev data!
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/material_intel_test
VECTOR_DIMENSION=1536

# Redis Settings
# Note: Use a separate Redis DB index for testing
REDIS_URL=redis://localhost:6379/1

# API Settings
API_BASE_URL=http://localhost:8000

# AI Provider Settings
# Mock providers should be used to avoid burning real API credits during automated tests
AI_PROVIDER=mock
LLM_API_KEY=test_key_do_not_use
EMBEDDING_MODEL=mock-embedding-model

# Security Settings
JWT_SECRET=test_jwt_secret_do_not_use_in_prod

# Storage Settings
# Use a temporary or isolated storage path for test artifacts
STORAGE_BACKEND=local
STORAGE_PATH=./data/test_storage
