# National Material Intelligence & Harmonization Platform
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is in .gitignore.

# ─── Application ───────────────────────────────────────────
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────
# Option A: Use Neon / Supabase / RDS PostgreSQL (recommended for production)
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require
VECTOR_DIMENSION=768

# Option B: Use local SQLite (great for local dev — no setup needed)
# DATABASE_URL=sqlite:///./platform.db

# ─── Redis ─────────────────────────────────────────────────
# For Upstash (managed Redis over TLS):
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:PORT
# For local Redis:
# REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-key

# ─── AI / LLM Settings ─────────────────────────────────────
AI_PROVIDER=local
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=all-mpnet-base-v2

# ─── Storage ───────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./data/raw

# ─── API ───────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ─── Demo Credentials ──────────────────────────────────────
# Default demo accounts created by the seeder script
DEMO_ADMIN_PASSWORD=admin123
DEMO_ENGINEER_PASSWORD=engineer123
